{
  "name": "grind",
  "productName": "GRIND",
  "version": "1.0.0",
  "description": "GRIND — production, sound design and socials hub",
  "main": "main.js",
  "author": "Hugo",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/unit.cjs",
    "test:ui": "electron test/visual.cjs",
    "icon": "node scripts/make-icon.cjs",
    "pack": "electron-packager . GRIND --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist --overwrite --prune=true --ignore=\"(^/dist|^/test|^/scripts|^/\\.git|^/shot-.*\\.png|^/GRIND\\.md|^/README\\.md)\"",
    "shortcut": "electron scripts/shortcut.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^33.2.0"
  }
}
